{
  "name": "@tbib-image-viewer/react",
  "version": "0.1.0",
  "description": "High-performance React Image Viewer & Swipe Gallery with Hand-Free Annotation Suite",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles.css": "./dist/index.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@fortawesome/free-solid-svg-icons": "^6.6.0",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "@tbib-image-viewer/core": "*",
    "ogl": "^1.0.11"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "keywords": [
    "react",
    "image-viewer",
    "gallery",
    "lightbox",
    "photoswipe",
    "sketch",
    "pen",
    "highlighter",
    "laser",
    "eraser",
    "medical",
    "tbib"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
