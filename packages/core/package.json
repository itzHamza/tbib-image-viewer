{
  "name": "@tbib-image-viewer/core",
  "version": "0.1.2",
  "description": "Framework-agnostic coordinate math, annotation engine, stroke smoothing, and native-res canvas export for TBiB Image Viewer",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run"
  },
  "devDependencies": {
    "tsup": "^8.0.2",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "keywords": [
    "image-viewer",
    "annotation",
    "sketch",
    "pen",
    "highlighter",
    "laser",
    "gallery",
    "tbib"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
