{
  "name": "tbib-image-viewer-monorepo",
  "private": true,
  "description": "Monorepo for TBiB Image & Gallery Viewer with Hand-Free Annotation Suite",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
