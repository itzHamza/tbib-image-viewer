  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "baseline-browser-mapping": "^2.11.32",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
